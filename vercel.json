{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)|\\.well-known(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/metadata.json",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/token.png",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
